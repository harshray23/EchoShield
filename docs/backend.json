
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User account information.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "name": { "type": "string" },
        "photo": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "ScamAnalysis": {
      "title": "Scam Analysis",
      "description": "Forensic result of a scam detection scan.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["screenshot", "voice", "text"] },
        "riskScore": { "type": "number", "description": "Risk score from 0 to 100" },
        "riskLevel": { "type": "string", "enum": ["secure", "suspicious", "malicious"] },
        "scamType": { "type": "string" },
        "confidence": { "type": "number" },
        "summary": { "type": "string" },
        "redFlags": { "type": "array", "items": { "type": "string" } },
        "psychology": { "type": "string" },
        "recommendations": { "type": "array", "items": { "type": "string" } },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "riskScore", "riskLevel", "scamType"]
    }
  },
  "auth": {
    "providers": ["google.com", "password", "anonymous"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile data."
    },
    "/analyses/{analysisId}": {
      "schema": "ScamAnalysis",
      "description": "A collection of scam analyses."
    }
  }
}
