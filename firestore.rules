
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User Profile Protection: Users can only manage their own profile data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Forensic Record Isolation: Users can only access their own analysis history
    match /analyses/{analysisId} {
      // Allow read (get and list) if the document's userId matches the authenticated user
      // Queries MUST include: where('userId', '==', auth.uid)
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      
      // Allow creation only if the authenticated user is the owner of the record
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      
      // Allow deletion only by the owner
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
      
      // Forensic integrity: Records are immutable once generated to maintain chain of custody
      allow update: if false;
    }
    
    // Inert trigger for Security Rules deployment: security_patch_v6_list_resolution
  }
}
