
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User Profile Protection: Users can only manage their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Analysis History Isolation: Users can only read and write their own forensic data
    match /analyses/{analysisId} {
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if false; // Forensic records are immutable once generated
    }
  }
}
