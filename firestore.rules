rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User Profile Protocol: Strict ownership of account metadata
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Forensic Archive: Owner-only access for individual records and collection listing
    match /analyses/{analysisId} {
      // Combined read rule to cover both 'get' and 'list' operations securely
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      
      // Creation requires authentication and ownership stamp
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      
      // Records are immutable for forensic integrity; only deletion by owner is permitted
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update: if false;
    }
    
    // Deployment Version Stamp: v12_index_aware_error_triage
  }
}
